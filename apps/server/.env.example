APP_ENV=dev
VENDURE_SERVER_PORT=3000
# Generate one, e.g. `openssl rand -base64 24`
COOKIE_SECRET=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
# Token of the default channel; the storefront's VENDURE_CHANNEL_TOKEN must match.
DEFAULT_CHANNEL_TOKEN=default-channel
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
# Production only: public URL of the asset server, e.g. https://my-shop.com/assets/
# ASSET_URL_PREFIX=

# Postgres with pgvector — `docker compose up -d postgres_db` starts one on port 6543
# using these values.
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=change-me
DB_SCHEMA=public

# ---------------------------------------------------------------------------
# AI assistant — configure ONE provider. Without any, the store runs normally and
# the AI features are switched off.
# ---------------------------------------------------------------------------

# 1) OpenAI — chat, embeddings and web search (competitor research).
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# 2) Azure OpenAI — chat and web search; embeddings too with an embedding deployment.
#    (Next to OPENAI_API_KEY, Azure is the fallback when OpenAI fails.)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
# Only if the embedding deployment is on another resource / key:
AZURE_OPENAI_EMBEDDING_RESOURCE_NAME=
AZURE_OPENAI_EMBEDDING_API_KEY=

# 3) Self-hosted or OpenAI-compatible — Ollama, vLLM, LM Studio, DeepSeek, OpenRouter…
#    The chat model must support tool calling. No web search unless you add one in code.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_CHAT_MODEL=qwen3:14b
# LLM_EMBEDDING_MODEL=nomic-embed-text
# LLM_EMBEDDING_DIMENSIONS=768
